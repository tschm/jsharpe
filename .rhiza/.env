# .rhiza/.env — project-local environment overrides (optional)
#
# This file is optional.  If absent, rhiza.mk falls back to built-in defaults:
#   SOURCE_FOLDER     = src
#   MARIMO_FOLDER     = docs/notebooks
#   RHIZA_CI_OS_MATRIX = ["ubuntu-latest"]
#
# Add or uncomment only the variables you want to override.
# Variables defined here are exported to all Make recipes.

# The notebooks live under book/, not at the docs/notebooks default. While this pointed
# at the default, `make marimo` and the notebook export in `make book` both took their
# "folder missing, skipping" branch, and marimo.mk never added the folder to
# DEPTRY_FOLDERS — so nothing was validated, exported, or dependency-checked.
MARIMO_FOLDER=book/marimo/notebooks
SOURCE_FOLDER=src
RHIZA_CI_OS_MATRIX=["ubuntu-latest","macos-latest","windows-latest"]
